# Port the API and (in production) the built client are served from.
PORT=3001

# Comma-separated list of allowed browser origins, or * to allow any.
# In production set this to the site's real origin, e.g. https://taqueue.example.edu
CORS_ORIGIN=*

# How long a disconnected student keeps their place in the queue (ms).
STUDENT_GRACE_MS=45000

# How long a disconnected TA stays on the board before being removed (ms).
TA_GRACE_MS=90000

# What happens to a student whose TA disconnects mid-session:
#   requeue  - the student goes back to their queue, keeping their ticket number (default)
#   complete - the session is counted as finished
ON_TA_DISCONNECT=requeue

# A room with nobody connected is deleted after this long (ms).
EMPTY_ROOM_TTL_MS=900000

# Hard ceiling on room lifetime, connected or not (ms).
MAX_ROOM_LIFETIME_MS=43200000

# Per-socket rate limit.
RATE_LIMIT_MAX=40
RATE_LIMIT_WINDOW_MS=10000
