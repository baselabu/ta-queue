# Port the API and (in production) the built client are served from.
PORT=3001

# Comma-separated list of allowed browser origins, or * to allow any.
# In production set this to the site's real origin, e.g. https://taqueue.example.edu
CORS_ORIGIN=*

# Nobody is ever removed for being offline: students are told to close their phone after
# taking a number, and TAs work on their own things for hours between students. A student
# leaves the queue when they say so or when a TA removes them.

# How long a finished or removed student can still read their result on their own phone.
RESULT_LINGER_MS=600000

# A room with nobody connected AND nobody queued is deleted after this long (ms).
EMPTY_ROOM_TTL_MS=7200000

# Hard ceiling on room lifetime, connected or not (ms).
MAX_ROOM_LIFETIME_MS=43200000

# Per-socket rate limit.
RATE_LIMIT_MAX=40
RATE_LIMIT_WINDOW_MS=10000
