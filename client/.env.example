# Where the Socket.IO server lives. Leave empty when the server also serves the built
# client (the default production setup) - the app then uses its own origin.
VITE_SERVER_URL=http://localhost:3001

# The URL encoded into the QR code. Set this to the public address students will reach,
# which may differ from the origin the dashboard is open on (e.g. a LAN IP during a lab).
VITE_PUBLIC_URL=
